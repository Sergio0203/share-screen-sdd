# Copie para .env (que não vai para o repositório) e troque os valores antes de implantar.
# Usado pelo docker-compose.yml (T10).

# Domínio do site. O servidor de mídia usa também turn.<domínio> (os dois apontando para a máquina).
DOMINIO=telao.exemplo.com

# Chave e segredo compartilhados entre o app e o servidor de mídia (LiveKit).
# O segredo precisa de pelo menos 32 caracteres; gere um com: openssl rand -base64 32
LIVEKIT_API_KEY=troque-esta-chave
LIVEKIT_API_SECRET=troque-este-segredo-com-32-caracteres-ou-mais
